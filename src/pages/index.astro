---
import "../styles/global.css";
import AppNav from "../components/AppNav.astro";
import { getCurrentUserAccounts } from "../lib/accountRepository";

const accounts = getCurrentUserAccounts();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>LEX8R Trading OS</title>
    <meta
      name="description"
      content="LEX8R Trading OS — Trading journal, portfolio and analytics."
    />
  </head>

  <body>
    <div class="app app-shell">

      <AppNav />

      <main class="main">

        <header class="topbar">
          <div>
            <div class="eyebrow">TRADING COMMAND CENTER</div>
            <h1>Dashboard</h1>
          </div>

          <div class="topbar-right">
            <div class="market-status">
              <span class="status-dot"></span>
              MARKET MONITOR
            </div>

            <button class="profile">MK</button>
          </div>
        </header>

        <section class="hero">

          <div class="hero-copy">
            <div class="eyebrow">PORTFOLIO OVERVIEW</div>
            <div class="hero-value">
              $3,084.50
            </div>
            <div class="hero-change">
              <span>+$126.00</span>
              <small>today</small>
            </div>
          </div>

          <div class="hero-meta">
            <div>
              <span>WIN RATE</span>
              <strong>68.4%</strong>
            </div>

            <div>
              <span>PROFIT FACTOR</span>
              <strong>2.31</strong>
            </div>

            <div>
              <span>OPEN RISK</span>
              <strong>0.00%</strong>
            </div>
          </div>

        </section>

        <section class="cards">

          <article class="metric-card">
            <div class="metric-label">TOTAL EQUITY</div>
            <div class="metric-value">$3,084.50</div>
            <div class="metric-note positive">+7.4% overall</div>
          </article>

          <article class="metric-card">
            <div class="metric-label">TODAY'S P&L</div>
            <div class="metric-value positive">+$126.00</div>
            <div class="metric-note">4 trades</div>
          </article>

          <article class="metric-card">
            <div class="metric-label">WIN RATE</div>
            <div class="metric-value">68.4%</div>
            <div class="metric-note">Last 30 trades</div>
          </article>

          <article class="metric-card">
            <div class="metric-label">AVERAGE R</div>
            <div class="metric-value positive">+1.84R</div>
            <div class="metric-note">Per trade</div>
          </article>

        </section>

        <section class="grid">

          <article class="panel equity-panel">
            <div class="panel-header">
              <div>
                <div class="eyebrow">PERFORMANCE</div>
                <h2>Equity Curve</h2>
              </div>

              <button class="period">30D ▾</button>
            </div>

            <div class="chart">
              <div class="grid-line line-1"></div>
              <div class="grid-line line-2"></div>
              <div class="grid-line line-3"></div>
              <div class="grid-line line-4"></div>

              <svg viewBox="0 0 800 260" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="area" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#d4af37" stop-opacity=".30" />
                    <stop offset="100%" stop-color="#d4af37" stop-opacity="0" />
                  </linearGradient>
                </defs>

                <path
                  class="area"
                  d="M0 220
                     C60 215 75 190 120 195
                     C170 200 190 155 235 165
                     C285 175 300 130 350 145
                     C400 160 420 105 465 120
                     C510 135 535 80 580 95
                     C630 110 650 65 690 75
                     C735 85 760 42 800 50
                     L800 260 L0 260 Z"
                />

                <path
                  class="curve"
                  d="M0 220
                     C60 215 75 190 120 195
                     C170 200 190 155 235 165
                     C285 175 300 130 350 145
                     C400 160 420 105 465 120
                     C510 135 535 80 580 95
                     C630 110 650 65 690 75
                     C735 85 760 42 800 50"
                />

                <circle cx="800" cy="50" r="5" class="curve-dot" />
              </svg>

              <div class="chart-labels">
                <span>SEP 01</span>
                <span>SEP 08</span>
                <span>SEP 15</span>
                <span>SEP 22</span>
                <span>SEP 28</span>
              </div>
            </div>
          </article>

          <article class="panel risk-panel">
            <div class="panel-header">
              <div>
                <div class="eyebrow">PROP FIRM</div>
                <h2>Risk Monitor</h2>
              </div>
              <span class="badge safe">SAFE</span>
            </div>

            <div class="risk-item">
              <div class="risk-top">
                <span>Daily Drawdown</span>
                <strong>$18 / $100</strong>
              </div>
              <div class="progress">
                <div style="width:18%"></div>
              </div>
            </div>

            <div class="risk-item">
              <div class="risk-top">
                <span>Maximum Drawdown</span>
                <strong>$34 / $200</strong>
              </div>
              <div class="progress">
                <div style="width:17%"></div>
              </div>
            </div>

            <div class="risk-item">
              <div class="risk-top">
                <span>Profit Target</span>
                <strong>$84 / $200</strong>
              </div>
              <div class="progress gold">
                <div style="width:42%"></div>
              </div>
            </div>

            <div class="risk-footer">
              <span>Risk per trade</span>
              <strong>1.00%</strong>
            </div>
          </article>

        </section>

        <section class="lower-grid">

          <article class="panel accounts-panel">
            <div class="panel-header">
              <div>
                <div class="eyebrow">PORTFOLIO</div>
                <h2>Accounts</h2>
              </div>

              <button class="text-button">VIEW ALL →</button>
            </div>

            <div class="accounts">

              {accounts.map((account) => (
                <div class="account-row">
                  <div class="account-icon">
                    {account.name.substring(0, 1)}
                  </div>

                  <div class="account-info">
                    <strong>{account.name}</strong>
                    <span>{account.type}</span>
                  </div>

                  <div class="account-balance">
                    <strong>
                      ${account.startingBalance.toLocaleString()}
                    </strong>
                    <span class="positive">
                      $0.00
                    </span>
                  </div>

                  <span class="account-status">
                    {account.status}
                  </span>
                </div>
              ))}

            </div>
          </article>

          <article class="panel trades-panel">
            <div class="panel-header">
              <div>
                <div class="eyebrow">JOURNAL</div>
                <h2>Recent Trades</h2>
              </div>

              <button class="text-button">JOURNAL →</button>
            </div>

            <div class="trades">

              <div class="trade-row">
                <div class="trade-time">—</div>

                <div class="trade-symbol">
                  <strong>NO TRADES</strong>
                  <span>Awaiting journal data</span>
                </div>

                <div class="trade-result">
                  <strong>—</strong>
                  <span>—</span>
                </div>
              </div>

            </div>
          </article>

        </section>

        <footer>
          <span>LEX8R TRADING OS</span>
          <span>v0.1 • LOCAL DEVELOPMENT</span>
        </footer>

      </main>
    </div>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        background: #050506;
      }

      :global(body) {
        margin: 0;
        background: #050506;
        color: #f1f1f1;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      .app {
        min-height: 100vh;
        display: flex;
        background:
          radial-gradient(circle at 70% -20%, rgba(40,123,255,.08), transparent 30%),
          #050506;
      }

      .sidebar {
        width: 240px;
        min-height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        padding: 28px 16px;
        border-right: 1px solid #1a1a1e;
        background: rgba(8,8,10,.96);
        display: flex;
        flex-direction: column;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 0 10px 32px;
      }

      .brand-mark {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border: 1px solid #d4af37;
        color: #d4af37;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: -1px;
      }

      .brand-name {
        font-weight: 800;
        letter-spacing: 3px;
        font-size: 15px;
      }

      .brand-subtitle {
        color: #77777e;
        font-size: 8px;
        letter-spacing: 2px;
        margin-top: 3px;
      }

      nav {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .nav-section {
        color: #4f4f56;
        font-size: 9px;
        letter-spacing: 1.8px;
        font-weight: 700;
        padding: 18px 12px 7px;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 12px;
        color: #85858d;
        text-decoration: none;
        font-size: 12px;
        border: 1px solid transparent;
        transition: .15s ease;
      }

      .nav-item span {
        width: 16px;
        text-align: center;
        font-size: 13px;
      }

      .nav-item:hover {
        color: #ddd;
        background: #111114;
      }

      .nav-item.active {
        color: #e8e8e8;
        background: linear-gradient(90deg, rgba(212,175,55,.10), rgba(212,175,55,.025));
        border-color: rgba(212,175,55,.18);
      }

      .nav-item.active span {
        color: #d4af37;
      }

      .system-status {
        margin-top: auto;
        padding: 12px;
        color: #626269;
        font-size: 9px;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #38d996;
        box-shadow: 0 0 10px rgba(56,217,150,.7);
        display: inline-block;
      }

      .main {
        margin-left: 240px;
        width: calc(100% - 240px);
        min-height: 100vh;
        padding: 32px 38px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 34px;
      }

      .eyebrow {
        color: #5f6068;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 7px;
      }

      h1 {
        margin: 0;
        font-size: 27px;
        letter-spacing: -.7px;
      }

      h2 {
        margin: 0;
        font-size: 15px;
        letter-spacing: -.2px;
      }

      .topbar-right {
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .market-status {
        color: #707078;
        font-size: 9px;
        letter-spacing: 1.2px;
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .profile {
        border: 1px solid #29292e;
        background: #111114;
        color: #d4af37;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        font-size: 10px;
        font-weight: 700;
      }

      .hero {
        min-height: 190px;
        border: 1px solid #1b1b20;
        background:
          linear-gradient(115deg, rgba(212,175,55,.07), transparent 42%),
          #0a0a0d;
        padding: 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        position: relative;
        overflow: hidden;
      }

      .hero::after {
        content: "";
        position: absolute;
        right: -100px;
        top: -100px;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        border: 1px solid rgba(40,123,255,.12);
        box-shadow:
          0 0 0 40px rgba(40,123,255,.02),
          0 0 0 80px rgba(40,123,255,.015);
      }

      .hero-value {
        font-size: 42px;
        font-weight: 700;
        letter-spacing: -2px;
      }

      .hero-change {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
      }

      .hero-change span {
        color: #38d996;
        font-size: 13px;
        font-weight: 700;
      }

      .hero-change small {
        color: #55555d;
      }

      .hero-meta {
        display: flex;
        gap: 42px;
        margin-right: 80px;
      }

      .hero-meta div {
        display: flex;
        flex-direction: column;
        gap: 7px;
      }

      .hero-meta span,
      .metric-label {
        color: #62626a;
        font-size: 8px;
        letter-spacing: 1.5px;
        font-weight: 700;
      }

      .hero-meta strong {
        font-size: 17px;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 14px;
      }

      .metric-card {
        background: #0a0a0d;
        border: 1px solid #1b1b20;
        padding: 20px;
      }

      .metric-value {
        margin-top: 10px;
        font-size: 23px;
        font-weight: 700;
      }

      .metric-note {
        color: #55555d;
        font-size: 10px;
        margin-top: 8px;
      }

      .positive {
        color: #38d996 !important;
      }

      .negative {
        color: #ff5f66 !important;
      }

      .grid {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(300px, 1fr);
        gap: 14px;
        margin-bottom: 14px;
      }

      .lower-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }

      .panel {
        background: #0a0a0d;
        border: 1px solid #1b1b20;
        padding: 22px;
      }

      .panel-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 24px;
      }

      .period {
        border: 1px solid #25252b;
        background: #111114;
        color: #777780;
        padding: 7px 10px;
        font-size: 9px;
      }

      .chart {
        height: 260px;
        position: relative;
        overflow: hidden;
      }

      .chart svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 230px;
      }

      .grid-line {
        position: absolute;
        left: 0;
        right: 0;
        border-top: 1px dashed #1a1a1f;
      }

      .line-1 { top: 10%; }
      .line-2 { top: 35%; }
      .line-3 { top: 60%; }
      .line-4 { top: 85%; }

      .curve {
        fill: none;
        stroke: #d4af37;
        stroke-width: 2.2;
        vector-effect: non-scaling-stroke;
      }

      .area {
        fill: url(#area);
      }

      .curve-dot {
        fill: #d4af37;
        filter: drop-shadow(0 0 5px rgba(212,175,55,.8));
      }

      .chart-labels {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-between;
        color: #4f4f56;
        font-size: 8px;
        letter-spacing: .5px;
      }

      .badge {
        font-size: 8px;
        letter-spacing: 1px;
        padding: 5px 8px;
      }

      .safe {
        color: #38d996;
        background: rgba(56,217,150,.08);
        border: 1px solid rgba(56,217,150,.15);
      }

      .risk-item {
        margin-bottom: 23px;
      }

      .risk-top {
        display: flex;
        justify-content: space-between;
        color: #777780;
        font-size: 10px;
        margin-bottom: 8px;
      }

      .risk-top strong {
        color: #d6d6da;
        font-weight: 600;
      }

      .progress {
        height: 4px;
        background: #19191e;
        overflow: hidden;
      }

      .progress div {
        height: 100%;
        background: #38d996;
      }

      .progress.gold div {
        background: #d4af37;
      }

      .risk-footer {
        border-top: 1px solid #19191e;
        padding-top: 16px;
        display: flex;
        justify-content: space-between;
        color: #66666e;
        font-size: 10px;
      }

      .risk-footer strong {
        color: #d4af37;
      }

      .text-button {
        border: 0;
        background: transparent;
        color: #5c5c65;
        font-size: 8px;
        letter-spacing: 1px;
        cursor: pointer;
      }

      .accounts,
      .trades {
        display: flex;
        flex-direction: column;
      }

      .account-row {
        min-height: 65px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-top: 1px solid #17171b;
      }

      .account-icon {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        background: #131317;
        border: 1px solid #25252b;
        color: #d4af37;
        font-size: 10px;
        font-weight: 700;
      }

      .account-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
      }

      .account-info strong {
        font-size: 10px;
      }

      .account-info span {
        color: #55555d;
        font-size: 8px;
      }

      .account-balance {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
      }

      .account-balance strong {
        font-size: 10px;
      }

      .account-balance span {
        font-size: 9px;
      }

      .account-status {
        font-size: 7px;
        color: #38d996;
        border: 1px solid rgba(56,217,150,.15);
        padding: 4px 6px;
        letter-spacing: 1px;
      }

      .trade-row {
        min-height: 65px;
        display: flex;
        align-items: center;
        border-top: 1px solid #17171b;
      }

      .trade-time {
        width: 52px;
        color: #55555d;
        font-size: 9px;
      }

      .trade-symbol {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
      }

      .trade-symbol strong {
        font-size: 10px;
      }

      .trade-symbol span {
        font-size: 7px;
        letter-spacing: 1px;
      }

      .long {
        color: #38d996;
      }

      .short {
        color: #ff5f66;
      }

      .trade-result {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
      }

      .trade-result strong {
        font-size: 10px;
      }

      .trade-result span {
        color: #55555d;
        font-size: 8px;
      }

      footer {
        display: flex;
        justify-content: space-between;
        padding: 28px 4px 10px;
        color: #36363c;
        font-size: 8px;
        letter-spacing: 1px;
      }

      @media (max-width: 1100px) {
        .sidebar {
          width: 200px;
        }

        .main {
          margin-left: 200px;
          width: calc(100% - 200px);
          padding: 25px;
        }

        .hero-meta {
          margin-right: 0;
        }
      }

      @media (max-width: 850px) {
        .sidebar {
          display: none;
        }

        .main {
          margin-left: 0;
          width: 100%;
          padding: 18px;
        }

        .cards {
          grid-template-columns: repeat(2, 1fr);
        }

        .grid,
        .lower-grid {
          grid-template-columns: 1fr;
        }

        .hero {
          flex-direction: column;
          align-items: flex-start;
          gap: 25px;
        }

        .hero-meta {
          width: 100%;
          justify-content: space-between;
        }
      }

      @media (max-width: 500px) {
        .cards {
          grid-template-columns: 1fr;
        }

        .hero-value {
          font-size: 34px;
        }
      }
    </style>

    <script>
      import { getCurrentUserTrades } from "../lib/tradeRepository";
      import {
        getCurrentUserAccounts
      } from "../lib/accountRepository";

      import {
        resolveAccountId
      } from "../lib/accounts";

      const accounts = getCurrentUserAccounts();
      import { calculateAnalytics } from "../lib/analyticsEngine";

      const money = (value: number) =>
        `${value < 0 ? "-" : ""}$${Math.abs(value).toFixed(2)}`;

      const signedMoney = (value: number) =>
        `${value >= 0 ? "+" : "-"}$${Math.abs(value).toFixed(2)}`;

      const signedR = (value: number) =>
        `${value >= 0 ? "+" : ""}${value.toFixed(2)}R`;

      function localDateKey(date = new Date()) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");

        return `${year}-${month}-${day}`;
      }

      function updateDashboard() {
        const trades = getCurrentUserTrades();

        const analytics = calculateAnalytics(trades);

        const totalStartingBalance = accounts.reduce(
          (sum, account) => sum + account.startingBalance,
          0
        );

        const portfolio = totalStartingBalance + analytics.totalPnL;

        const today = localDateKey();

        const todayPnL = trades
          .filter((trade) => trade.date === today)
          .reduce(
            (sum, trade) => sum + Number(trade.pnl || 0),
            0
          );

        const recentTrades = [...trades]
          .sort(
            (a, b) =>
              new Date(b.createdAt || b.date).getTime() -
              new Date(a.createdAt || a.date).getTime()
          )
          .slice(0, 5);

        const heroValue =
          document.querySelector(".hero-value");

        if (heroValue) {
          heroValue.textContent = money(portfolio);
        }

        const heroChange =
          document.querySelector(".hero-change");

        if (heroChange) {
          heroChange.textContent = signedMoney(todayPnL);
        }

        const metricValues =
          document.querySelectorAll(".metric-value");

        if (metricValues[0]) {
          metricValues[0].textContent = money(portfolio);
        }

        if (metricValues[1]) {
          metricValues[1].textContent = signedMoney(todayPnL);
        }

        if (metricValues[2]) {
          metricValues[2].textContent =
            `${analytics.winRate.toFixed(1)}%`;
        }

        if (metricValues[3]) {
          metricValues[3].textContent =
            signedR(analytics.averageR);
        }

        const accountCards =
          document.querySelectorAll(".account-row");

        accounts.forEach((account, index) => {
          const card = accountCards[index];

          if (!card) return;

          const accountTrades = trades.filter(
            (trade) =>
              resolveAccountId(trade.accountId) === account.id
          );

          const accountAnalytics =
            calculateAnalytics(accountTrades);

          const equity =
            account.startingBalance +
            accountAnalytics.totalPnL;

          const balance =
            card.querySelector(".account-balance strong");

          const pnl =
            card.querySelector(".account-balance span");

          if (balance) {
            balance.textContent = money(equity);
          }

          if (pnl) {
            pnl.textContent =
              signedMoney(accountAnalytics.totalPnL);

            pnl.className =
              accountAnalytics.totalPnL >= 0
                ? "positive"
                : "negative";
          }
        });

        const tradeRows =
          document.querySelectorAll(".trades .trade-row");

        tradeRows.forEach((row) => row.remove());

        const tradeTable =
          document.querySelector(".trades");

        if (tradeTable) {
          recentTrades.forEach((trade) => {
            const row =
              document.createElement("div");

            row.className = "trade-row";

            const time =
              trade.createdAt
                ? new Date(trade.createdAt)
                    .toLocaleTimeString([], {
                      hour: "2-digit",
                      minute: "2-digit"
                    })
                : "";

            row.innerHTML = `
              <span>${time}</span>
              <span>${trade.instrument}</span>
              <span>${trade.direction}</span>
              <span>${signedR(Number(trade.resultR || 0))}</span>
              <span>${signedMoney(Number(trade.pnl || 0))}</span>
            `;

            tradeTable.appendChild(row);
          });
        }
      }

      updateDashboard();

      window.addEventListener(
        "storage",
        updateDashboard
      );
    </script>
  </body>
</html>
