---
import { accounts } from "../lib/accounts";

const totalStarting = accounts.reduce(
  (sum, account) => sum + account.startingBalance,
  0
);

const totalEquity = accounts.reduce(
  (sum, account) => sum + account.currentBalance,
  0
);

const totalPnL = accounts.reduce(
  (sum, account) => sum + account.totalProfitLoss,
  0
);

const totalDrawdown = accounts.reduce(
  (sum, account) => sum + account.currentDrawdown,
  0
);

const formatMoney = (value: number) =>
  new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    minimumFractionDigits: 2,
  }).format(value);

const pnlClass = (value: number) =>
  value >= 0 ? "positive" : "negative";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LEX8R — Portfolio</title>
  </head>

  <body>
    <div class="app">

      <aside class="sidebar">
        <div class="brand">
          <div class="logo">L8</div>
          <div>
            <div class="brand-name">LEX8R</div>
            <div class="brand-sub">TRADING OS</div>
          </div>
        </div>

        <nav>
          <a href="/">⌂ <span>Dashboard</span></a>
          <a href="/portfolio" class="active">◈ <span>Portfolio</span></a>
          <a href="#">▣ <span>Journal</span></a>
          <a href="#">▦ <span>Calendar</span></a>
          <a href="#">◫ <span>Analytics</span></a>
          <a href="#">◆ <span>Prop Firm</span></a>
          <a href="#">◇ <span>LEX8R System</span></a>
        </nav>

        <div class="system">
          <span class="dot"></span>
          SYSTEM ONLINE
        </div>
      </aside>

      <main>

        <header class="topbar">
          <div>
            <div class="eyebrow">PORTFOLIO</div>
            <h1>Account Command Center</h1>
            <p>Monitor every trading account from one interface.</p>
          </div>

          <button class="add-button">
            + Add Account
          </button>
        </header>

        <section class="overview">

          <div class="stat-card">
            <span>Total Equity</span>
            <strong>{formatMoney(totalEquity)}</strong>
            <small>Across all accounts</small>
          </div>

          <div class="stat-card">
            <span>Total P&amp;L</span>
            <strong class={pnlClass(totalPnL)}>
              {totalPnL >= 0 ? "+" : ""}{formatMoney(totalPnL)}
            </strong>
            <small>Net performance</small>
          </div>

          <div class="stat-card">
            <span>Starting Capital</span>
            <strong>{formatMoney(totalStarting)}</strong>
            <small>Combined accounts</small>
          </div>

          <div class="stat-card">
            <span>Current Drawdown</span>
            <strong class={totalDrawdown > 0 ? "negative" : "positive"}>
              {formatMoney(totalDrawdown)}
            </strong>
            <small>Across portfolio</small>
          </div>

        </section>

        <section class="section-header">
          <div>
            <h2>Trading Accounts</h2>
            <p>Prop-firm and personal capital allocation.</p>
          </div>
          <span class="account-count">{accounts.length} ACCOUNTS</span>
        </section>

        <section class="accounts">

          {accounts.map((account) => {
            const progress =
              account.profitTarget > 0
                ? Math.min(
                    100,
                    Math.max(
                      0,
                      (account.totalProfitLoss / account.profitTarget) * 100
                    )
                  )
                : 0;

            const drawdownProgress =
              account.maxDrawdown > 0
                ? Math.min(
                    100,
                    (account.currentDrawdown / account.maxDrawdown) * 100
                  )
                : 0;

            return (
              <article class="account-card">

                <div class="account-top">
                  <div>
                    <div class="account-type">
                      {account.type}
                    </div>

                    <h3>{account.name}</h3>

                    <span class="firm">
                      {account.firm}
                    </span>
                  </div>

                  <span class={`status ${account.status.toLowerCase()}`}>
                    {account.status}
                  </span>
                </div>

                <div class="balance">
                  <span>Current Equity</span>
                  <strong>
                    {formatMoney(account.currentBalance)}
                  </strong>
                </div>

                <div class="metrics">

                  <div>
                    <span>P&amp;L</span>
                    <strong class={pnlClass(account.totalProfitLoss)}>
                      {account.totalProfitLoss >= 0 ? "+" : ""}
                      {formatMoney(account.totalProfitLoss)}
                    </strong>
                  </div>

                  <div>
                    <span>Risk / Trade</span>
                    <strong>{account.riskPerTrade}%</strong>
                  </div>

                  <div>
                    <span>Daily Loss Limit</span>
                    <strong>{formatMoney(account.dailyLossLimit)}</strong>
                  </div>

                  <div>
                    <span>Max Drawdown</span>
                    <strong>{formatMoney(account.maxDrawdown)}</strong>
                  </div>

                </div>

                <div class="progress-section">
                  <div class="progress-label">
                    <span>Profit Target</span>

                    <span>
                      {account.profitTarget > 0
                        ? `${progress.toFixed(0)}%`
                        : "N/A"}
                    </span>
                  </div>

                  <div class="progress">
                    <div
                      class="progress-fill gold"
                      style={`width: ${progress}%`}
                    ></div>
                  </div>
                </div>

                <div class="progress-section">
                  <div class="progress-label">
                    <span>Drawdown Used</span>
                    <span>{drawdownProgress.toFixed(0)}%</span>
                  </div>

                  <div class="progress">
                    <div
                      class="progress-fill blue"
                      style={`width: ${drawdownProgress}%`}
                    ></div>
                  </div>
                </div>

                <div class="account-footer">
                  <span>
                    Profit Split
                    <strong>{account.profitSplit}%</strong>
                  </span>

                  <button>View Account →</button>
                </div>

              </article>
            );
          })}

        </section>

      </main>
    </div>
  </body>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(body) {
      margin: 0;
      background: #050505;
      color: #f5f5f5;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    .app {
      min-height: 100vh;
      display: flex;
      background:
        radial-gradient(
          circle at 75% 0%,
          rgba(40, 123, 255, 0.08),
          transparent 30%
        ),
        #050505;
    }

    .sidebar {
      width: 245px;
      min-height: 100vh;
      padding: 26px 18px;
      border-right: 1px solid #1c1c21;
      background: #080809;
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 4px 8px 35px;
    }

    .logo {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border: 1px solid #d4af37;
      color: #d4af37;
      font-weight: 900;
      border-radius: 10px;
      letter-spacing: -2px;
    }

    .brand-name {
      font-weight: 900;
      letter-spacing: 2px;
    }

    .brand-sub {
      font-size: 9px;
      color: #777;
      letter-spacing: 2px;
      margin-top: 3px;
    }

    nav {
      display: grid;
      gap: 7px;
    }

    nav a {
      color: #85858b;
      text-decoration: none;
      padding: 13px 12px;
      border-radius: 8px;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 12px;
      transition: 0.2s;
    }

    nav a:hover,
    nav a.active {
      color: #fff;
      background: #111114;
    }

    nav a.active {
      border-left: 2px solid #d4af37;
      color: #d4af37;
    }

    .system {
      position: absolute;
      bottom: 25px;
      left: 28px;
      color: #666;
      font-size: 9px;
      letter-spacing: 1.5px;
    }

    .dot {
      width: 7px;
      height: 7px;
      background: #38d996;
      display: inline-block;
      border-radius: 50%;
      margin-right: 7px;
      box-shadow: 0 0 10px rgba(56, 217, 150, 0.6);
    }

    main {
      margin-left: 245px;
      width: calc(100% - 245px);
      padding: 38px 42px 60px;
    }

    .topbar {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 35px;
    }

    .eyebrow {
      color: #d4af37;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 2px;
      margin-bottom: 7px;
    }

    h1 {
      font-size: 30px;
      margin: 0;
      letter-spacing: -1px;
    }

    .topbar p,
    .section-header p {
      color: #777;
      margin: 8px 0 0;
      font-size: 13px;
    }

    .add-button {
      background: #d4af37;
      border: none;
      color: #050505;
      padding: 12px 18px;
      border-radius: 7px;
      font-weight: 800;
      cursor: pointer;
    }

    .overview {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 42px;
    }

    .stat-card {
      background: #0b0b0d;
      border: 1px solid #1c1c21;
      padding: 20px;
      border-radius: 10px;
    }

    .stat-card span,
    .stat-card small {
      color: #737379;
      display: block;
    }

    .stat-card span {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .stat-card strong {
      display: block;
      font-size: 25px;
      margin: 10px 0 6px;
    }

    .stat-card small {
      font-size: 11px;
    }

    .positive {
      color: #36d996 !important;
    }

    .negative {
      color: #ff5c6c !important;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 17px;
    }

    h2 {
      margin: 0;
      font-size: 19px;
    }

    .account-count {
      font-size: 10px;
      color: #666;
      letter-spacing: 1.5px;
    }

    .accounts {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .account-card {
      background: #0b0b0d;
      border: 1px solid #1c1c21;
      border-radius: 11px;
      padding: 21px;
    }

    .account-top {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 25px;
    }

    .account-type {
      color: #d4af37;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    h3 {
      margin: 7px 0 4px;
      font-size: 18px;
    }

    .firm {
      color: #68686e;
      font-size: 11px;
    }

    .status {
      height: fit-content;
      font-size: 9px;
      font-weight: 800;
      padding: 5px 8px;
      border-radius: 5px;
      background: rgba(54, 217, 150, 0.08);
      color: #36d996;
      border: 1px solid rgba(54, 217, 150, 0.2);
    }

    .status.evaluation {
      color: #d4af37;
      background: rgba(212, 175, 55, 0.08);
      border-color: rgba(212, 175, 55, 0.2);
    }

    .balance {
      border-top: 1px solid #17171b;
      border-bottom: 1px solid #17171b;
      padding: 18px 0;
    }

    .balance span {
      color: #666;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .balance strong {
      display: block;
      font-size: 28px;
      margin-top: 7px;
    }

    .metrics {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      padding: 19px 0;
    }

    .metrics span {
      color: #666;
      display: block;
      font-size: 10px;
      margin-bottom: 5px;
    }

    .metrics strong {
      font-size: 13px;
    }

    .progress-section {
      margin-top: 15px;
    }

    .progress-label {
      display: flex;
      justify-content: space-between;
      color: #777;
      font-size: 10px;
      margin-bottom: 7px;
    }

    .progress {
      height: 5px;
      background: #17171b;
      border-radius: 20px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      border-radius: 20px;
    }

    .gold {
      background: #d4af37;
    }

    .blue {
      background: #287bff;
    }

    .account-footer {
      border-top: 1px solid #17171b;
      margin-top: 20px;
      padding-top: 17px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 10px;
      color: #666;
    }

    .account-footer strong {
      color: #ddd;
      margin-left: 6px;
    }

    .account-footer button {
      border: 0;
      background: transparent;
      color: #d4af37;
      font-size: 10px;
      cursor: pointer;
    }

    @media (max-width: 1050px) {
      .overview {
        grid-template-columns: repeat(2, 1fr);
      }

      .accounts {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .sidebar {
        display: none;
      }

      main {
        margin-left: 0;
        width: 100%;
        padding: 25px 18px;
      }

      .topbar {
        align-items: flex-start;
        gap: 20px;
        flex-direction: column;
      }

      .overview {
        grid-template-columns: 1fr;
      }
    }
  </style>
</html>
